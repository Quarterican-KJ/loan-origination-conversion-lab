# Copy to .env and adjust locally. Never commit real credentials or real customer data.
# These values are placeholders; the application does not read them yet.

APP_ENV=development
LOG_LEVEL=INFO

# Local SQLite development database (synthetic data only), relative to the project root. Matches
# the seeding CLI's default --database path; the CLI does not read this file. Tests use in-memory
# or temporary databases.
DATABASE_URL=sqlite:///./data/loan_lab_dev.db

# Folder for synthetic legacy extract files used by the conversion engine
LEGACY_DATA_DIR=./data/legacy
